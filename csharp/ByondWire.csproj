<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <PackageId>ByondWire</PackageId>
    <Version>0.1.1</Version>
    <Authors>Wirewraith</Authors>
    <Description>Small standard-library BYOND Topic client.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/Wirewraith/byond-wire</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="ByondWire.cs" />
    <InternalsVisibleTo Include="ByondWire.Tests" />
    <None Include="README.md;PROTOCOL.md;LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
